# Secrets and settings for the ContractSoup Edge Functions.
#
# 1. Copy this file to  supabase/functions/.env   (that file is ignored by git).
# 2. Put your real values in the copy. NEVER put a real key in this template,
#    in src/, in the root .env, or in any variable whose name starts with VITE_.
#
# Local:       `supabase start` loads supabase/functions/.env by itself.
# Production:  supabase secrets set GEMINI_API_KEY=YOUR_KEY
#              or, for everything in the file at once:
#              supabase secrets set --env-file supabase/functions/.env
#              or Supabase Dashboard -> Edge Functions -> Secrets.

# Required. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional. The Gemini model that reads contracts. Change it here, not in the code.
GEMINI_MODEL=gemini-3.8-flash

# ---- Optional settings. The values shown are the defaults. Remove the "#" to change one. ----

# How hard the model thinks: low, medium or high. Left unset, the model's own default is used.
# GEMINI_THINKING_LEVEL=medium

# Longest one call to Gemini may take, and how many times a failed call is tried again.
# GEMINI_TIMEOUT_MS=120000
# GEMINI_MAX_RETRIES=2

# Longest a whole request may take. Supabase stops a function after 150 seconds.
# AI_REQUEST_DEADLINE_MS=140000

# Size limits for one request.
# AI_MAX_PAGES_PER_REQUEST=60
# AI_MAX_CHARS_PER_PAGE=30000
# AI_MAX_TOTAL_CHARS=200000

# Only let these websites call the function from a browser (comma-separated origins).
# Left unset, any origin may call it, and the caller must still be signed in.
# AI_ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:5173

# Only let these accounts use the AI reader (comma-separated user ids from Authentication -> Users).
# Left unset, every signed-in user of the project may use it, at the cost of your Gemini key.
# AI_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000

# For finding a setup problem only: also log the text of Gemini's error messages.
# Google's error text can repeat parts of a request, so leave this off in normal use.
# AI_LOG_UPSTREAM_ERRORS=false
